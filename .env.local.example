# Public Supabase project URL. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key only. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing Go API. Use the local backend during development.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Current tenant for X-Business-ID. Required by the Go API.
# Do not invent this value; copy the business UUID for the signed-in user.
NEXT_PUBLIC_BUSINESS_ID=
